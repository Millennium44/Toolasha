{
    "name": "toolasha",
    "version": "3.86.1",
    "description": "Toolasha - Enhanced tools for Milky Way Idle",
    "type": "module",
    "scripts": {
        "build": "node scripts/check-bundle-sharing.mjs && BUILD_MODE=production rollup -c && node scripts/check-bundle-load-order.mjs",
        "check:sharing": "node scripts/check-bundle-sharing.mjs",
        "check:bundle-smoke": "node scripts/check-bundle-smoke.mjs --require-build",
        "check:bundle-parity": "node scripts/check-bundle-parity.mjs --require-build",
        "build:dev": "BUILD_TARGET=dev-standalone rollup -c",
        "build:enhancement": "rollup -c rollup.config.enhancement.js",
        "build:all": "npm run build && npm run build:enhancement",
        "watch": "rollup -c -w",
        "dev": "rollup -c -w",
        "test": "vitest run",
        "test:related": "vitest related --run",
        "test:watch": "vitest",
        "replay": "node scripts/replay-combat.mjs",
        "compare": "node scripts/compare-attribution.mjs",
        "lint": "eslint src/ scripts/check-root-files.js scripts/check-root-files.test.js",
        "lint:fix": "eslint src/ --fix",
        "format": "prettier --write \"src/**/*.js\" \"*.config.js\" \"**/*.md\"",
        "format:check": "prettier --check \"src/**/*.js\" \"*.config.js\" \"**/*.md\"",
        "lint:md": "markdownlint \"**/*.md\" --ignore node_modules",
        "lint:md:fix": "markdownlint \"**/*.md\" --ignore node_modules --fix",
        "lint:md:links": "find . -name '*.md' ! -path './node_modules/*' -exec markdown-link-check --quiet {} \\;",
        "version:sync": "node scripts/sync-version.js",
        "changelog:stamp": "node scripts/stamp-changelog-version.js",
        "changelog:dedupe": "node scripts/dedupe-release-notes.js",
        "prepare": "husky && node scripts/setup-merge-driver.mjs",
        "check:requires": "node scripts/check-require-urls.mjs",
        "audit:handlers": "node scripts/audit-game-handlers.mjs"
    },
    "keywords": [
        "userscript",
        "milkywayidle",
        "tampermonkey"
    ],
    "author": "bot7420",
    "license": "CC-BY-NC-SA-4.0",
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.2",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.2",
        "chart.js": "4.6.1",
        "chartjs-plugin-datalabels": "2.2.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.14.0",
        "happy-dom": "^21.0.4",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "markdown-link-check": "^3.14.2",
        "markdownlint-cli": "^0.50.0",
        "mathjs": "15.2.0",
        "prettier": "^3.9.10",
        "rollup": "^4.68.0",
        "rollup-plugin-banner2": "^1.2.2",
        "vitest": "^5.1.0"
    },
    "overrides": {
        "markdownlint-cli": {
            "js-yaml": "^5.4.1"
        },
        "get-uri": {
            "basic-ftp": "^6.2.1"
        },
        "re2js": "^2.8.7",
        "minimatch": "^11.0.1",
        "katex": "^0.18.2"
    },
    "engines": {
        "node": ">=22.12"
    },
    "lint-staged": {
        "src/**/*.js": [
            "eslint --fix",
            "prettier --write",
            "npm run test:related --"
        ],
        "rollup.config.js": [
            "prettier --write"
        ],
        "*.config.js": [
            "prettier --write"
        ],
        "*.md": [
            "prettier --write",
            "markdownlint --fix"
        ]
    }
}
